<?xml version="1.0"?>
<!-- Two independent own-state sensors. LocalNetwork does not cross entity boundaries.
     NoisyState changes belief, never physical truth directly. -->
<runscript name="Noisy state and local feedback">
  <run start="0" end="${duration=20}" dt="0.1" enable_gui="false" start_paused="false" time_warp="0" />
  <seed>12345</seed>
  <end_condition>time</end_condition>
  <output_type>all</output_type>
  <network>LocalNetwork</network>
  <network>GlobalNetwork</network>
  <metrics>SimpleCollisionMetrics</metrics>
  <param_common name="state_noise">
    <pos_noise_0>0 ${position_sigma=0.5}</pos_noise_0>
    <pos_noise_1>0 ${position_sigma=0.5}</pos_noise_1>
    <pos_noise_2>${altitude_bias=2} ${position_sigma=0.5}</pos_noise_2>
    <vel_noise_0>0 ${velocity_sigma=0.2}</vel_noise_0>
    <vel_noise_1>0 ${velocity_sigma=0.2}</vel_noise_1>
    <vel_noise_2>0 ${velocity_sigma=0.2}</vel_noise_2>
    <orient_noise_0>0 0</orient_noise_0>
    <orient_noise_1>0 0</orient_noise_1>
    <orient_noise_2>0 0</orient_noise_2>
  </param_common>
  <entity_common name="aircraft">
    <count>1</count><x>0</x><z>200</z><speed>20</speed><heading>0</heading>
    <variance_x>0</variance_x><variance_y>0</variance_y><variance_z>0</variance_z>
    <visual_model>sphere</visual_model>
    <autonomy speed="20">Straight</autonomy>
    <controller>SimpleAircraftControllerPID</controller>
    <motion_model>SimpleAircraft</motion_model>
    <sensor param_common="state_noise" loop_rate="${sensor_rate=10}">NoisyState</sensor>
  </entity_common>
  <entity entity_common="aircraft"><team_id>1</team_id><y>-60</y><color>70 130 255</color></entity>
  <entity entity_common="aircraft"><team_id>2</team_id><y>60</y><color>255 100 70</color></entity>
</runscript>
