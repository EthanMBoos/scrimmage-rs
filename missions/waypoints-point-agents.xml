<?xml version="1.0"?>
<runscript name="Point agents sharing a route">
  <run start="0" end="12" dt="0.1" enable_gui="false" start_paused="false" time_warp="0" />
  <seed>12345</seed><end_condition>time</end_condition><output_type>all</output_type>
  <network>GlobalNetwork</network><metrics>SimpleCollisionMetrics</metrics>
  <entity_interaction waypoints="10,0,0;10,10,0" update_at_s="${update_at=3}"
                      update_waypoints="0,20,0;-10,20,0">WaypointBroadcast</entity_interaction>
  <entity_common name="point_agent">
    <count>1</count><x>0</x><z>0</z><heading>0</heading>
    <variance_x>0</variance_x><variance_y>0</variance_y><variance_z>0</variance_z>
    <autonomy waypoints="10,0,0;10,10,0" arrival_radius_m="0.01" speed="5">WaypointFollower</autonomy>
    <controller>SingleIntegratorControllerSimple</controller><motion_model>SingleIntegrator</motion_model><visual_model>sphere</visual_model>
  </entity_common>
  <entity entity_common="point_agent"><team_id>1</team_id><y>-2</y><color>70 130 255</color></entity>
  <entity entity_common="point_agent"><team_id>2</team_id><y>2</y><color>255 100 70</color></entity>
</runscript>
