<?xml version="1.0"?>
<runscript name="One auction over a spherical radio network">
  <!-- The auction's messages and winner are not written to events.json, the summary,
       or Rerun yet; in the viewer this is three stationary agents. The contract tests
       in crates/core/tests/support/perception_communication.rs check the outcome. -->
  <run start="0" end="7" dt="0.1" enable_gui="false" />
  <seed>${seed=12345}</seed><end_condition>time</end_condition><output_type>all</output_type>
  <network range="${range=100}" prob_transmit="${prob_transmit=1}">SphereNetwork</network>
  <metrics>SimpleCollisionMetrics</metrics>
  <entity_common name="bidder">
    <count>1</count><y>0</y><z>0</z><heading>0</heading>
    <variance_x>0</variance_x><variance_y>0</variance_y><variance_z>0</variance_z>
    <autonomy>AuctionAssign</autonomy>
    <controller>SingleIntegratorControllerSimple</controller>
    <motion_model>SingleIntegrator</motion_model><visual_model>sphere</visual_model>
  </entity_common>
  <entity entity_common="bidder"><team_id>1</team_id><x>0</x><color>70 130 255</color></entity>
  <entity entity_common="bidder"><team_id>1</team_id><x>50</x><color>70 130 255</color></entity>
  <!-- Outside the auctioneer's range: this agent receives no start and submits no bid. -->
  <entity entity_common="bidder"><team_id>2</team_id><x>200</x><color>255 100 70</color></entity>
</runscript>
