<?xml version="1.0"?>
<!-- Rust-native route composition, not an unchanged C++ waypoint demo. -->
<runscript name="Aircraft shared waypoint update">
  <run start="0" end="60" dt="0.1" enable_gui="false" start_paused="false" time_warp="0" />
  <seed>12345</seed><end_condition>time</end_condition><output_type>all</output_type>
  <network>GlobalNetwork</network><metrics>SimpleCollisionMetrics</metrics>
  <entity_interaction waypoints="300,0,200;300,300,200;-300,300,200;-300,-300,200"
                      update_at_s="${update_at=12}"
                      update_waypoints="0,-300,200;-300,-300,200;-300,300,200;300,300,200">WaypointBroadcast</entity_interaction>
  <entity_common name="aircraft">
    <count>1</count><x>0</x><z>200</z><speed>20</speed><heading>0</heading>
    <variance_x>0</variance_x><variance_y>0</variance_y><variance_z>0</variance_z>
    <autonomy waypoints="300,0,200" arrival_radius_m="40" speed="20" repeat="true">WaypointFollower</autonomy>
    <controller>SimpleAircraftControllerPID</controller><motion_model>SimpleAircraft</motion_model><visual_model>sphere</visual_model>
  </entity_common>
  <entity entity_common="aircraft"><team_id>1</team_id><y>-30</y><color>70 130 255</color></entity>
  <entity entity_common="aircraft"><team_id>2</team_id><y>30</y><color>255 100 70</color></entity>
</runscript>
