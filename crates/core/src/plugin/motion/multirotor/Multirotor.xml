<?xml version="1.0"?>
<!-- Defaults from SCRIMMAGE Ubuntu-24.04 Multirotor (LGPL-3.0-or-later). SI units. -->
<params>
  <library>Multirotor_plugin</library>
  <gravity_magnitude>9.81</gravity_magnitude><mass>1.5</mass>
  <inertia_matrix>[0.0122 0 0] [0 0.0122 0] [0 0 0.0244]</inertia_matrix>
  <!-- Drag D = 0.5 c_D |V| V; thrust = c_T w^2 (N); torque = c_Q w^2 (N m). -->
  <c_D>0.058</c_D><c_T>5.45e-6</c_T><c_Q>2.284e-7</c_Q>
  <omega_max>1200</omega_max><omega_min>346.41</omega_min>
  <!-- One row per rotor: [direction x y z roll pitch yaw], body forward/left/up.
       Rotor i reads input motor_i (rad/s). Rotor roll/pitch/yaw are unused. -->
  <rotor_config>[CCW 0 -0.175 0 0 0 0] [CCW 0 0.175 0 0 0 0] [CW 0.175 0 0 0 0 0] [CW -0.175 0 0 0 0 0]</rotor_config>
  <write_csv>false</write_csv><show_shapes>false</show_shapes>
</params>
