<?xml version="1.0"?>
<runscript name="Measured contacts along a shared route">
  <!-- Nothing here consumes the measurements, and they are not recorded in run outputs
       or Rerun yet; this is a regression input. See the contract tests for a consumer. -->
  <run start="0" end="8" dt="0.1" enable_gui="false" />
  <seed>${seed=12345}</seed><end_condition>time</end_condition><output_type>all</output_type>
  <network>LocalNetwork</network><metrics>SimpleCollisionMetrics</metrics>
  <entity_common name="point_agent">
    <count>1</count><x>0</x><z>0</z><heading>0</heading>
    <variance_x>0</variance_x><variance_y>0</variance_y><variance_z>0</variance_z>
    <autonomy waypoints="30,0,0;30,20,0" speed="5">WaypointFollower</autonomy>
    <controller>SingleIntegratorControllerSimple</controller>
    <motion_model>SingleIntegrator</motion_model><visual_model>sphere</visual_model>
    <sensor>NoisyContacts</sensor>
  </entity_common>
  <entity entity_common="point_agent"><team_id>1</team_id><y>-5</y><color>70 130 255</color></entity>
  <entity entity_common="point_agent"><team_id>2</team_id><y>5</y><color>255 100 70</color></entity>
</runscript>
